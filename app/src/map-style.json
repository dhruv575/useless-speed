      "paint": {
        "line-color": "#fff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 15, 5]
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
